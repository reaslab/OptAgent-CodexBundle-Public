    {"id":"model.max_cut.qubo","type":"math_model","title":"Max-Cut binary partition model","summary":"Use binary side variables and edge cut indicators, with either a native quadratic objective or a linearized MILP.","payload":{"model_class":"MIQP or MILP","constraint_templates":["cut edge indicator linearization","binary vertex side assignment"],"objective":"maximize weighted crossing-edge sum","source_file":".agents/skills/opt-formulation/reference/problem-taxonomy.md"}},
    {"id":"model.qap.quadratic","type":"math_model","title":"QAP flow-distance quadratic model","summary":"Use binary facility-location assignment variables and pairwise products for flow times location distance.","payload":{"model_class":"MIQP/QIP","constraint_templates":["one location per facility","one facility per location","pairwise assignment products"],"objective":"minimize sum of flow[i,j] * distance[p,q] * assignment products","source_file":".agents/skills/opt-formulation/reference/problem-taxonomy.md"}},
    {"id":"model.set_multicover.canonical","type":"math_model","title":"Set multi-cover covering model","summary":"Binary set variables cover each element at least its required multiplicity at minimum set cost.","payload":{"model_class":"MILP","constraint_templates":["sum of covering selected sets >= requirement per element"],"objective":"minimize selected-set costs","source_file":".agents/skills/opt-formulation/reference/problem-taxonomy.md"}},
    {"id":"model.smallest_circle.socp","type":"math_model","title":"Smallest enclosing circle model","summary":"Continuous center and radius with a distance bound for every point; solve as SOCP or nonlinear convex model.","payload":{"model_class":"SOCP/NLP","constraint_templates":["euclidean distance from center to point <= radius"],"objective":"minimize radius","source_file":".agents/skills/opt-formulation/reference/problem-taxonomy.md"}},
    {"id":"model.social_golfer.cp","type":"math_model","title":"Social golfer grouping model","summary":"Assign each golfer to one group per week and bound every golfer-pair's co-membership across weeks.","payload":{"model_class":"CP-SAT/MILP","constraint_templates":["one group per golfer-week","fixed group size","pair meets at most once"],"objective":"feasibility","source_file":".agents/skills/opt-formulation/reference/problem-taxonomy.md"}},
    {"id":"model.pooling.minlp","type":"math_model","title":"Pooling nonlinear flow model","summary":"Balance feed, pool, and product flows while enforcing quality constraints containing flow-composition products.","payload":{"model_class":"MINLP or convex relaxation","constraint_templates":["material balance","pool quality bilinearities","product quality bounds"],"objective":"maximize profit","source_file":".agents/skills/opt-formulation/reference/problem-taxonomy.md"}},
    {"id":"model.unit_commitment.milp","type":"math_model","title":"Unit commitment dispatch model","summary":"Time-indexed commitment, startup, shutdown, generation, reserve, and demand-balance constraints.","payload":{"model_class":"MILP","constraint_templates":["demand balance","minimum/maximum generation","startup transition","minimum up/down time when specified"],"objective":"minimize fixed, variable, and startup cost","source_file":".agents/skills/opt-formulation/reference/problem-taxonomy.md"}},
